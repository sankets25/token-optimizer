# Anthropic API credentials
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Redis connection for the semantic cache (defaults work for a local `redis-server`)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Cache behavior
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=86400

# Router models (see config.py for the full model table)
ROUTER_CHEAP_MODEL=claude-haiku-4-5
ROUTER_EXPENSIVE_MODEL=claude-opus-4-8
